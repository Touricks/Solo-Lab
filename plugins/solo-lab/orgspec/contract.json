{
  "_说明": "飞书模板和插件之间的约定：脚本按含义处理的槽位。每个槽位在一个空间里对应哪个类型、字段、角色和状态，记在项目的 feishu/ids.json；有哪些流程、节点怎么排、每一步必填什么，只在飞书空间里，脚本运行时读。这里只用英文标识，中文名在 terms.zh.json。槽位增减时 contract_version 加一。",
  "contract_version": 1,
  "template": {
    "name": "research_template",
    "version": "2.1.0",
    "url": "https://project.feishu.cn/templates/detail/7f032046eb974cab877ce8df79389895"
  },
  "types": {
    "research_task": {
      "main_line": true,
      "fields": ["sequence", "sender", "main_doc", "source_item", "due", "blocked_reason", "blocked_since", "hypothesis_signoff", "next_step_signoff", "conclusion"],
      "roles": ["product", "alg", "rnd", "infra", "pmo", "issuer", "scribe"],
      "states": ["archived"]
    },
    "same_seq": {
      "fields": ["sequence", "sender", "main_doc", "source_item", "task_ref", "owner_session", "relation", "delivery_link", "due", "blocked_reason", "blocked_since"],
      "roles": ["issuer", "assignee", "scribe"],
      "states": ["queued", "doing", "verifying", "accepted", "archived"]
    },
    "cross_request": {
      "fields": ["sequence", "sender", "main_doc", "source_item", "task_ref", "from_sequence", "to_sequence", "delivery_link", "due", "blocked_reason", "blocked_since"],
      "roles": ["issuer", "assignee", "scribe"],
      "states": ["returned", "waiting", "doing", "verifying", "accepted", "archived"]
    },
    "decision": {
      "fields": ["sequence", "sender", "main_doc", "source_item", "task_ref", "urgency", "sign_result"],
      "roles": ["researcher", "scribe"],
      "states": ["pending", "decided", "archived"]
    },
    "feedback": {
      "fields": ["sequence", "sender", "main_doc", "task_ref"],
      "roles": ["pmo", "scribe"],
      "states": ["archived"]
    }
  },
  "fields": {
    "sequence": {"type": "select", "options": {"group": "seq"}},
    "sender": {"type": "text"},
    "main_doc": {"type": "link"},
    "source_item": {"type": "text"},
    "task_ref": {"type": "text"},
    "due": {"type": "date"},
    "blocked_reason": {"type": "text"},
    "blocked_since": {"type": "date"},
    "owner_session": {"type": "text"},
    "relation": {"type": "select", "options": {"group": "rel", "ids": ["assign", "execute"]}},
    "delivery_link": {"type": "link"},
    "from_sequence": {"type": "select", "options": {"group": "seq"}},
    "to_sequence": {"type": "select", "options": {"group": "seq"}},
    "urgency": {"type": "select"},
    "sign_result": {"type": "select", "options": {"group": "sign"}},
    "hypothesis_signoff": {"type": "text", "signature": true},
    "next_step_signoff": {"type": "text", "signature": true},
    "conclusion": {"type": "select"}
  },
  "roles": {
    "product": {"who": "sequence"},
    "alg": {"who": "sequence"},
    "rnd": {"who": "sequence"},
    "infra": {"who": "sequence"},
    "pmo": {"who": "sequence"},
    "issuer": {"who": "field", "field": {"research_task": "sender", "same_seq": "sender", "cross_request": "sender"}},
    "assignee": {"who": "field", "field": {"same_seq": "owner_session", "cross_request": "to_sequence"}},
    "researcher": {"who": "researcher"},
    "scribe": {"who": "scribe"}
  },
  "flow": {
    "archive_node": {"key": "archive", "role": "scribe", "state": "archived"},
    "sign_gate": {"type": "decision", "states": ["decided", "archived"], "result": "sign_result", "approved": "approved", "task": "task_ref"},
    "freeze": {"sealed_by": "hypothesis_signoff", "checked_before": "conclusion"},
    "rollback_needs_decision": ["research_task"],
    "closed": ["accepted", "archived"]
  }
}
